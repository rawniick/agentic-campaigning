{
  "name": "Distribution Sub-Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "distribute",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "distribute"
    },
    {
      "parameters": {
        "url": "={{ $env.NEXTJS_APP_URL }}/api/export",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "campaignId", "value": "={{ $json.campaignId }}" },
            { "name": "platforms", "value": "=[\"meta\"]" }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "name": "Meta Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 150]
    },
    {
      "parameters": {
        "url": "={{ $env.NEXTJS_APP_URL }}/api/export",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "campaignId", "value": "={{ $json.campaignId }}" },
            { "name": "platforms", "value": "=[\"google_ads\"]" }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "name": "Google Ads Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.NEXTJS_APP_URL }}/api/export/archive",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "campaignId", "value": "={{ $json.campaignId }}" }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "name": "Drive Archive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 450]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [800, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.NEXTJS_APP_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.N8N_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "action", "value": "status_update" },
            { "name": "campaignId", "value": "={{ $json.campaignId }}" },
            { "name": "data", "value": "={{ JSON.stringify({ status: 'published' }) }}" }
          ]
        },
        "options": {}
      },
      "name": "Status Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          { "node": "Meta Upload", "type": "main", "index": 0 },
          { "node": "Google Ads Upload", "type": "main", "index": 0 },
          { "node": "Drive Archive", "type": "main", "index": 0 }
        ]
      ]
    },
    "Meta Upload": { "main": [[{ "node": "Merge Results", "type": "main", "index": 0 }]] },
    "Google Ads Upload": { "main": [[{ "node": "Merge Results", "type": "main", "index": 1 }]] },
    "Drive Archive": { "main": [[{ "node": "Merge Results", "type": "main", "index": 0 }]] },
    "Merge Results": { "main": [[{ "node": "Status Update", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "distribution" }, { "name": "sub-workflow" }]
}
