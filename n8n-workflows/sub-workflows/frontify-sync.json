{
  "name": "Brand Brain - Frontify Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "frontify-sync-cron",
      "name": "Alle 6 Stunden",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "frontify-changed",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "frontify-sync-webhook",
      "name": "Frontify Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 500],
      "webhookId": "frontify-changed"
    },
    {
      "parameters": {
        "url": "={{ $env.NEXTJS_APP_URL }}/api/brand-brain/refresh",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.BRAND_BRAIN_REFRESH_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"source\": \"frontify\" }",
        "options": {}
      },
      "id": "frontify-sync-refresh",
      "name": "Cache Invalidieren (Frontify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "frontify-sync-check",
      "name": "Refresh Erfolgreich?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [780, 400]
    },
    {
      "parameters": {
        "content": "Frontify Brand Brain Sync erfolgreich",
        "options": {}
      },
      "id": "frontify-sync-success",
      "name": "Erfolg",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "content": "Frontify Sync fehlgeschlagen",
        "options": {}
      },
      "id": "frontify-sync-error",
      "name": "Fehler Loggen",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1020, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ received: true, timestamp: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "frontify-sync-respond",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1020, 600]
    }
  ],
  "connections": {
    "Alle 6 Stunden": {
      "main": [
        [
          {
            "node": "Cache Invalidieren (Frontify)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Frontify Webhook": {
      "main": [
        [
          {
            "node": "Cache Invalidieren (Frontify)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cache Invalidieren (Frontify)": {
      "main": [
        [
          {
            "node": "Refresh Erfolgreich?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh Erfolgreich?": {
      "main": [
        [
          {
            "node": "Erfolg",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fehler Loggen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Frontify Webhook": {
      "main": [
        [
          {
            "node": "Cache Invalidieren (Frontify)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Synchronisiert Frontify Brand Guidelines mit dem ACE Brand Brain Cache. Laeuft alle 6 Stunden oder bei Webhook-Trigger von Frontify.",
    "templateCredsSetupCompleted": true
  }
}
