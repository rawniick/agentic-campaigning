{
  "name": "ACE Metrics Sync (Daily)",
  "nodes": [
    {
      "name": "Daily Cron",
      "type": "n8n-nodes-base.cron",
      "position": [250, 300],
      "parameters": {
        "triggerTimes": {
          "item": [{ "hour": 6, "minute": 0 }]
        }
      }
    },
    {
      "name": "Fetch Active Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "parameters": {
        "url": "={{$env.NEXTJS_APP_URL}}/api/campaigns?status=published",
        "method": "GET",
        "authentication": "headerAuth"
      }
    },
    {
      "name": "Sync Metrics Per Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 300],
      "parameters": {
        "url": "={{$env.NEXTJS_APP_URL}}/api/campaigns/{{$json.id}}/metrics/sync",
        "method": "POST",
        "authentication": "headerAuth"
      }
    },
    {
      "name": "Log Results",
      "type": "n8n-nodes-base.set",
      "position": [850, 300],
      "parameters": {
        "values": {
          "string": [{ "name": "synced_at", "value": "={{$now.toISO()}}" }]
        }
      }
    }
  ],
  "connections": {
    "Daily Cron": { "main": [[{ "node": "Fetch Active Campaigns" }]] },
    "Fetch Active Campaigns": { "main": [[{ "node": "Sync Metrics Per Campaign" }]] },
    "Sync Metrics Per Campaign": { "main": [[{ "node": "Log Results" }]] }
  }
}
