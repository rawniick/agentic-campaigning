{
  "name": "ACE Campaign v2 Pipeline",
  "nodes": [
    {
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "path": "campaign-v2-pipeline",
        "httpMethod": "POST",
        "authentication": "headerAuth"
      }
    },
    {
      "name": "Extract Campaign ID",
      "type": "n8n-nodes-base.set",
      "position": [450, 300],
      "parameters": {
        "values": {
          "string": [{ "name": "campaignId", "value": "={{$json.campaignId}}" }]
        }
      }
    },
    {
      "name": "Wait: Input Confirmation",
      "type": "n8n-nodes-base.wait",
      "position": [650, 300],
      "webhookId": "input-confirmation",
      "parameters": { "resume": "webhook" }
    },
    {
      "name": "Generate Strategy",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 300],
      "parameters": {
        "url": "={{$env.NEXTJS_APP_URL}}/api/generate/concept",
        "method": "POST",
        "body": { "campaignId": "={{$json.campaignId}}", "step": "strategy" }
      }
    },
    {
      "name": "Wait: Strategy Approval",
      "type": "n8n-nodes-base.wait",
      "position": [1050, 300],
      "webhookId": "strategy",
      "parameters": { "resume": "webhook" }
    },
    {
      "name": "Check Strategy Result",
      "type": "n8n-nodes-base.if",
      "position": [1250, 300],
      "parameters": {
        "conditions": { "string": [{ "value1": "={{$json.action}}", "operation": "equals", "value2": "approved" }] }
      }
    },
    {
      "name": "Generate Draft Concept",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1450, 200],
      "parameters": {
        "url": "={{$env.NEXTJS_APP_URL}}/api/generate/draft-concept",
        "method": "POST",
        "body": { "campaignId": "={{$json.campaignId}}" }
      }
    },
    {
      "name": "Wait: Draft Concept Approval",
      "type": "n8n-nodes-base.wait",
      "position": [1650, 200],
      "webhookId": "draft_concept",
      "parameters": { "resume": "webhook" }
    },
    {
      "name": "Generate Detail Concept",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1850, 200],
      "parameters": {
        "url": "={{$env.NEXTJS_APP_URL}}/api/generate/detail-concept",
        "method": "POST",
        "body": { "campaignId": "={{$json.campaignId}}" }
      }
    },
    {
      "name": "Wait: Detail Concept Approval",
      "type": "n8n-nodes-base.wait",
      "position": [2050, 200],
      "webhookId": "detail_concept",
      "parameters": { "resume": "webhook" }
    },
    {
      "name": "Generate Translations",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2250, 200],
      "parameters": {
        "url": "={{$env.NEXTJS_APP_URL}}/api/generate/translate",
        "method": "POST",
        "body": { "campaignId": "={{$json.campaignId}}" }
      }
    },
    {
      "name": "Wait: Translations Approval",
      "type": "n8n-nodes-base.wait",
      "position": [2450, 200],
      "webhookId": "translations",
      "parameters": { "resume": "webhook" }
    },
    {
      "name": "Generate Assets",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2650, 200],
      "parameters": {
        "url": "={{$env.NEXTJS_APP_URL}}/api/generate/content",
        "method": "POST",
        "body": { "campaignId": "={{$json.campaignId}}", "generationMode": "ai_image" }
      }
    },
    {
      "name": "Wait: Assets Approval",
      "type": "n8n-nodes-base.wait",
      "position": [2850, 200],
      "webhookId": "assets",
      "parameters": { "resume": "webhook" }
    },
    {
      "name": "Distribution",
      "type": "n8n-nodes-base.httpRequest",
      "position": [3050, 200],
      "parameters": {
        "url": "={{$env.NEXTJS_APP_URL}}/api/export",
        "method": "POST",
        "body": { "campaignId": "={{$json.campaignId}}", "platforms": ["meta", "google_ads", "google_drive"] }
      }
    },
    {
      "name": "Pipeline Complete",
      "type": "n8n-nodes-base.set",
      "position": [3250, 200],
      "parameters": {
        "values": { "string": [{ "name": "status", "value": "completed" }] }
      }
    },
    {
      "name": "Strategy Rejected",
      "type": "n8n-nodes-base.noOp",
      "position": [1450, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Extract Campaign ID" }]] },
    "Extract Campaign ID": { "main": [[{ "node": "Wait: Input Confirmation" }]] },
    "Wait: Input Confirmation": { "main": [[{ "node": "Generate Strategy" }]] },
    "Generate Strategy": { "main": [[{ "node": "Wait: Strategy Approval" }]] },
    "Wait: Strategy Approval": { "main": [[{ "node": "Check Strategy Result" }]] },
    "Check Strategy Result": {
      "main": [
        [{ "node": "Generate Draft Concept" }],
        [{ "node": "Strategy Rejected" }]
      ]
    },
    "Generate Draft Concept": { "main": [[{ "node": "Wait: Draft Concept Approval" }]] },
    "Wait: Draft Concept Approval": { "main": [[{ "node": "Generate Detail Concept" }]] },
    "Generate Detail Concept": { "main": [[{ "node": "Wait: Detail Concept Approval" }]] },
    "Wait: Detail Concept Approval": { "main": [[{ "node": "Generate Translations" }]] },
    "Generate Translations": { "main": [[{ "node": "Wait: Translations Approval" }]] },
    "Wait: Translations Approval": { "main": [[{ "node": "Generate Assets" }]] },
    "Generate Assets": { "main": [[{ "node": "Wait: Assets Approval" }]] },
    "Wait: Assets Approval": { "main": [[{ "node": "Distribution" }]] },
    "Distribution": { "main": [[{ "node": "Pipeline Complete" }]] }
  }
}
