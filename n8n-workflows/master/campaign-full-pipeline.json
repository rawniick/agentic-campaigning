{
  "name": "ACE Campaign Full Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "campaign-full-pipeline",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "campaign-full-pipeline"
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "campaignId", "value": "={{ $json.body.campaignId }}" }
          ]
        },
        "options": {}
      },
      "name": "Extract Campaign ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [400, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, executionId: $execution.id, campaignId: $json.campaignId }) }}",
        "options": {}
      },
      "name": "Respond: Pipeline Started",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTJS_APP_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.N8N_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'generate_strategy', campaignId: $json.campaignId }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Generate Strategy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [800, 300]
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {
          "webhookSuffix": "={{ $('Extract Campaign ID').item.json.campaignId }}-strategy"
        }
      },
      "name": "Wait: Strategy Selection",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "campaignId", "value": "={{ $('Extract Campaign ID').item.json.campaignId }}" },
            { "name": "strategyAction", "value": "={{ $json.body.action ?? 'strategy_selected' }}" },
            { "name": "strategyIndex", "value": "={{ $json.body.strategyIndex ?? 0 }}" }
          ]
        },
        "options": {}
      },
      "name": "Restore Context: Strategy",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTJS_APP_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.N8N_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'generate_concept', campaignId: $json.campaignId, data: { strategyIndex: parseInt($json.strategyIndex) || 0 } }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "name": "Generate Concept",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {
          "webhookSuffix": "={{ $('Extract Campaign ID').item.json.campaignId }}-concept"
        }
      },
      "name": "Wait: Concept Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1600, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "campaignId", "value": "={{ $('Extract Campaign ID').item.json.campaignId }}" },
            { "name": "approvalAction", "value": "={{ $json.body.action ?? 'approved' }}" }
          ]
        },
        "options": {}
      },
      "name": "Restore Context: Concept",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1800, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.approvalAction }}", "operation": "equals", "value2": "approved" }
          ]
        }
      },
      "name": "Check: Concept Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTJS_APP_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.N8N_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'translate', campaignId: $json.campaignId }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "name": "Translate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2200, 200]
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {
          "webhookSuffix": "={{ $('Extract Campaign ID').item.json.campaignId }}-translations"
        }
      },
      "name": "Wait: Translation Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [2400, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "campaignId", "value": "={{ $('Extract Campaign ID').item.json.campaignId }}" },
            { "name": "approvalAction", "value": "={{ $json.body.action ?? 'approved' }}" }
          ]
        },
        "options": {}
      },
      "name": "Restore Context: Translations",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [2600, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.approvalAction }}", "operation": "equals", "value2": "approved" }
          ]
        }
      },
      "name": "Check: Translations Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2800, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTJS_APP_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.N8N_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'generate_content', campaignId: $json.campaignId }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "name": "Generate Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [3000, 100]
    },
    {
      "parameters": {
        "resume": "webhook",
        "options": {
          "webhookSuffix": "={{ $('Extract Campaign ID').item.json.campaignId }}-assets"
        }
      },
      "name": "Wait: Assets Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [3200, 100]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "campaignId", "value": "={{ $('Extract Campaign ID').item.json.campaignId }}" },
            { "name": "approvalAction", "value": "={{ $json.body.action ?? 'approved' }}" }
          ]
        },
        "options": {}
      },
      "name": "Restore Context: Assets",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [3400, 100]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.approvalAction }}", "operation": "equals", "value2": "approved" }
          ]
        }
      },
      "name": "Check: Assets Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [3600, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTJS_APP_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.N8N_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'distribute', campaignId: $json.campaignId, data: { platforms: ['meta', 'google_ads', 'google_drive'] } }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "name": "Distribute",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [3800, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTJS_APP_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.N8N_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'archive', campaignId: $('Extract Campaign ID').item.json.campaignId }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Archive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [4000, 0]
    },
    {
      "parameters": {},
      "name": "Pipeline Complete",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [4200, 0]
    },
    {
      "parameters": {},
      "name": "Pipeline Aborted: Concept Rejected",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2200, 400]
    },
    {
      "parameters": {},
      "name": "Pipeline Aborted: Translations Rejected",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3000, 400]
    },
    {
      "parameters": {},
      "name": "Pipeline Aborted: Assets Rejected",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3800, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Extract Campaign ID", "type": "main", "index": 0 }]] },
    "Extract Campaign ID": { "main": [[{ "node": "Respond: Pipeline Started", "type": "main", "index": 0 }]] },
    "Respond: Pipeline Started": { "main": [[{ "node": "Generate Strategy", "type": "main", "index": 0 }]] },
    "Generate Strategy": { "main": [[{ "node": "Wait: Strategy Selection", "type": "main", "index": 0 }]] },
    "Wait: Strategy Selection": { "main": [[{ "node": "Restore Context: Strategy", "type": "main", "index": 0 }]] },
    "Restore Context: Strategy": { "main": [[{ "node": "Generate Concept", "type": "main", "index": 0 }]] },
    "Generate Concept": { "main": [[{ "node": "Wait: Concept Approval", "type": "main", "index": 0 }]] },
    "Wait: Concept Approval": { "main": [[{ "node": "Restore Context: Concept", "type": "main", "index": 0 }]] },
    "Restore Context: Concept": { "main": [[{ "node": "Check: Concept Approved?", "type": "main", "index": 0 }]] },
    "Check: Concept Approved?": {
      "main": [
        [{ "node": "Translate", "type": "main", "index": 0 }],
        [{ "node": "Pipeline Aborted: Concept Rejected", "type": "main", "index": 0 }]
      ]
    },
    "Translate": { "main": [[{ "node": "Wait: Translation Approval", "type": "main", "index": 0 }]] },
    "Wait: Translation Approval": { "main": [[{ "node": "Restore Context: Translations", "type": "main", "index": 0 }]] },
    "Restore Context: Translations": { "main": [[{ "node": "Check: Translations Approved?", "type": "main", "index": 0 }]] },
    "Check: Translations Approved?": {
      "main": [
        [{ "node": "Generate Content", "type": "main", "index": 0 }],
        [{ "node": "Pipeline Aborted: Translations Rejected", "type": "main", "index": 0 }]
      ]
    },
    "Generate Content": { "main": [[{ "node": "Wait: Assets Approval", "type": "main", "index": 0 }]] },
    "Wait: Assets Approval": { "main": [[{ "node": "Restore Context: Assets", "type": "main", "index": 0 }]] },
    "Restore Context: Assets": { "main": [[{ "node": "Check: Assets Approved?", "type": "main", "index": 0 }]] },
    "Check: Assets Approved?": {
      "main": [
        [{ "node": "Distribute", "type": "main", "index": 0 }],
        [{ "node": "Pipeline Aborted: Assets Rejected", "type": "main", "index": 0 }]
      ]
    },
    "Distribute": { "main": [[{ "node": "Archive", "type": "main", "index": 0 }]] },
    "Archive": { "main": [[{ "node": "Pipeline Complete", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "tags": [{ "name": "campaign" }, { "name": "master" }, { "name": "ace" }]
}
