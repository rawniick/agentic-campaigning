{
  "_meta": {
    "version": "1.0.0",
    "brand": "coop_mobile",
    "description": "Corporate Identity Regeln fuer Coop Mobile"
  },
  "colors": {
    "primary": "#E3000B",
    "primary_name": "Coop Rot",
    "secondary": "#1D1D1B",
    "secondary_name": "Coop Schwarz",
    "accent": "#FFD700",
    "accent_name": "Coop Gelb",
    "background": "#FFFFFF",
    "text": "#1D1D1B",
    "usage_rules": [
      "Primaerfarbe Rot nur fuer CTA-Buttons und Akzente",
      "Fliesstext immer in Schwarz auf Weiss",
      "Gelb sparsam fuer Highlights und Preise"
    ]
  },
  "typography": {
    "headline_font": "CoopNew-Bold",
    "body_font": "CoopNew-Regular",
    "fallback_font": "Arial, sans-serif",
    "headline_sizes": {
      "hero": "48px",
      "h1": "36px",
      "h2": "28px",
      "h3": "22px"
    },
    "body_size": "16px",
    "rules": [
      "Headlines immer in Bold",
      "Fliesstext nie kleiner als 14px",
      "Zeilenabstand mindestens 1.4"
    ]
  },
  "logo": {
    "logo_file": "coop-mobile-logo.svg",
    "min_size_px": 80,
    "clear_space": "Logohoehe als Mindestabstand",
    "placement": "oben-links oder unten-rechts",
    "background_rules": [
      "Logo auf weissem oder hellem Hintergrund",
      "Bei dunklem Hintergrund: weisse Logo-Variante",
      "Nie auf unruhigem Bildhintergrund"
    ],
    "forbidden": [
      "Logo drehen oder verzerren",
      "Logo-Farben aendern",
      "Logo auf rotem Hintergrund"
    ]
  },
  "image_style": {
    "photography": "Natuerlich, authentisch, Schweizer Ambiente",
    "models": "Diverse, echte Menschen, keine Stock-Foto-Optik",
    "forbidden": [
      "Uebertrieben gestellte Posen",
      "Kuenstliche Studiobeleuchtung",
      "Konkurrenz-Produkte im Bild"
    ]
  },
  "layout_rules": [
    "Preis immer prominent sichtbar (oberes Drittel)",
    "CTA-Button mindestens 44x44px Klickflaeche",
    "Maximal 3 Informationsebenen pro Asset",
    "Weissraum bewusst einsetzen, nicht ueberladen"
  ]
}
