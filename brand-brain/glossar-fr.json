{
  "_meta": {
    "version": "1.0.0",
    "language": "fr",
    "description": "Glossaire contraignant pour Coop Mobile FR. Ces termes DOIVENT etre utilises exactement ainsi."
  },
  "terms": {
    "5G sur le reseau Swisscom": {
      "use": "TOUJOURS pour les produits 5G",
      "wrong": ["reseau 5G", "Swisscom 5G", "sur le reseau 5G de Swisscom"],
      "context": "Mention obligatoire"
    },
    "Abonnement mobile": {
      "use": "Terme standard pour abonnement de telephonie mobile",
      "wrong": ["abo mobile", "forfait mobile", "contrat mobile"],
      "context": "General"
    },
    "Coop Mobile": {
      "use": "Toujours en majuscules, toujours en deux mots",
      "wrong": ["coop mobile", "CoopMobile", "COOP MOBILE", "Coop mobile"],
      "context": "Nom de marque"
    },
    "Rabais a vie": {
      "use": "Pour duration=lebenslang",
      "wrong": ["Rabais permanent", "Rabais durable", "Reduction a vie", "Remise a vie"],
      "context": "Promo"
    },
    "/mois": {
      "use": "Suffixe pour les prix mensuels",
      "wrong": ["/mo", "par mois", "/m", "mensuel"],
      "context": "Prix"
    },
    "CHF": {
      "use": "Avant le prix, avec espace: CHF 11.95",
      "wrong": ["Fr.", "SFr.", "11.95 CHF", "CHF11.95"],
      "context": "Prix"
    },
    "Commander maintenant": {
      "use": "CTA standard pour commande",
      "wrong": ["Commandez maintenant", "Acheter maintenant", "Commander"],
      "context": "CTA"
    },
    "En savoir plus": {
      "use": "CTA standard pour information",
      "wrong": ["Plus d'infos", "Decouvrir", "Lire plus"],
      "context": "CTA"
    },
    "Pas de frais d'activation": {
      "use": "Mention standard pour activation gratuite",
      "wrong": ["Activation gratuite", "Sans frais d'activation", "0 frais d'activation"],
      "context": "Promo"
    },
    "Duree minimale du contrat": {
      "use": "Terme juridique standard",
      "wrong": ["Duree minimum", "Engagement minimum", "Periode minimale"],
      "context": "Legal"
    }
  }
}
