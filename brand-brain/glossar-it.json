{
  "_meta": {
    "version": "1.0.0",
    "language": "it",
    "description": "Glossario vincolante per Coop Mobile IT. Questi termini DEVONO essere utilizzati esattamente cosi."
  },
  "terms": {
    "5G nella rete Swisscom": {
      "use": "SEMPRE per i prodotti 5G",
      "wrong": ["rete 5G", "Swisscom 5G", "nella rete 5G di Swisscom"],
      "context": "Menzione obbligatoria"
    },
    "Abbonamento mobile": {
      "use": "Termine standard per abbonamento di telefonia mobile",
      "wrong": ["abo mobile", "contratto mobile", "piano mobile"],
      "context": "Generale"
    },
    "Coop Mobile": {
      "use": "Sempre in maiuscolo, sempre come due parole",
      "wrong": ["coop mobile", "CoopMobile", "COOP MOBILE", "Coop mobile"],
      "context": "Nome del marchio"
    },
    "Sconto a vita": {
      "use": "Per duration=lebenslang",
      "wrong": ["Sconto permanente", "Sconto duraturo", "Riduzione a vita", "Sconto per sempre"],
      "context": "Promo"
    },
    "/mese": {
      "use": "Suffisso per i prezzi mensili",
      "wrong": ["/mo", "al mese", "/m", "mensile"],
      "context": "Prezzo"
    },
    "CHF": {
      "use": "Prima del prezzo, con spazio: CHF 11.95",
      "wrong": ["Fr.", "SFr.", "11.95 CHF", "CHF11.95"],
      "context": "Prezzo"
    },
    "Ordinare adesso": {
      "use": "CTA standard per ordine",
      "wrong": ["Ordina adesso", "Comprare adesso", "Acquista ora"],
      "context": "CTA"
    },
    "Scopri di piu": {
      "use": "CTA standard per informazione",
      "wrong": ["Maggiori informazioni", "Ulteriori info", "Leggi di piu"],
      "context": "CTA"
    },
    "Nessun costo di attivazione": {
      "use": "Menzione standard per attivazione gratuita",
      "wrong": ["Attivazione gratuita", "Senza costi di attivazione", "0 costi di attivazione"],
      "context": "Promo"
    },
    "Durata minima del contratto": {
      "use": "Termine giuridico standard",
      "wrong": ["Durata minima", "Impegno minimo", "Periodo minimo"],
      "context": "Legale"
    }
  }
}
