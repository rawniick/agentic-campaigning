# ============================================
# Agentic Campaigning – Environment Variables
# ============================================
# Kopiere diese Datei als .env.local und trage deine Keys ein:
#   cp .env.example .env.local

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- Google Drive (Brand Brain) ---
# Service Account Key als base64-enkodierter JSON-String
# Generieren: base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=xxx

# --- Frontify (Brand Guidelines API) ---
# Personal Developer Token: https://<domain>.frontify.com/api/developer/token
FRONTIFY_DOMAIN=acme.frontify.com
FRONTIFY_TOKEN=xxx
FRONTIFY_BRAND_ID=               # Optional, auto-discovers first brand

# --- Brand Brain Cache ---
BRAND_BRAIN_CACHE_TTL_SECONDS=3600
BRAND_BRAIN_REFRESH_SECRET=changeme

# --- Canva Connect API ---
CANVA_API_KEY=xxx
CANVA_BRAND_KIT_ID=xxx

# --- Meta Marketing API ---
META_ACCESS_TOKEN=xxx
META_AD_ACCOUNT_ID=xxx

# --- Google Drive Archiv (Export) ---
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=xxx

# --- Google Ads API ---
GOOGLE_ADS_DEVELOPER_TOKEN=xxx
GOOGLE_ADS_CLIENT_ID=xxx
GOOGLE_ADS_CLIENT_SECRET=xxx
GOOGLE_ADS_REFRESH_TOKEN=xxx
GOOGLE_ADS_CUSTOMER_ID=xxx

# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=xxx
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme123

# --- App URL (fuer n8n Callbacks) ---
NEXTJS_APP_URL=http://localhost:3000
