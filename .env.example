# ============================================
# ACE Wingo V1 — Environment Variables
# ============================================
# Kopiere diese Datei als .env.local und trage deine Keys ein:
#   cp .env.example .env.local

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Anthropic Claude API (Pflicht: Copy-Gen, Translation, Vision-QA) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Supabase (Pflicht: DB, Storage, Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx
# Direkt-Postgres-Verbindung fuer Server-Actions (pg.Pool). In Supabase:
# Settings > Database > Connection String > Session-Mode oder Pooler.
DATABASE_URL=postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres
# Bucket-Name fuer Asset-Storage (default: campaign-assets)
ACE_ASSETS_BUCKET=campaign-assets

# --- Active Brand (V1: nur "wingo") ---
ACE_ACTIVE_BRAND=wingo

# --- AI Image Provider (Phase 3: Hero-Image AI-Gen via fal.ai-Aggregator) ---
# fal.ai = ein Key, viele Modelle (Nano Banana 2 etc.). Die Registry in
# src/lib/imagegen/registry.ts steuert, welche Modelle im Frontend-Dropdown
# erscheinen (enabled-Flag). ACHTUNG vor Live-Schaltung: Lizenz der Modelle
# (Gemini/ByteDance) fuer kommerzielle Wingo/Swisscom-Werbung rechtlich klaeren
# (100%-Brand-KO + AI-Label-Pflicht). Modell-IDs auf fal.ai/explore/models pruefen.
FAL_KEY=

# --- Google Drive (ab Phase 5: einmaliger Library-Seed-Import) ---
# Service Account Key als base64-enkodierter JSON-String
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_HERO_LIBRARY_FOLDER_ID=
