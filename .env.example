# ============================================
# Agentic Campaigning – Environment Variables
# ============================================
# Kopiere diese Datei als .env.local und trage deine Keys ein:
#   cp .env.example .env.local

# --- App URL ---
NEXTJS_APP_URL=http://localhost:3000

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- Google Drive (Brand Brain Source) ---
# Service Account Key als base64-enkodierter JSON-String
# Generieren: base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=xxx

# --- Frontify (Brand Guidelines API) ---
# Personal Developer Token: https://<domain>.frontify.com/api/developer/token
FRONTIFY_DOMAIN=acme.frontify.com
FRONTIFY_TOKEN=xxx
FRONTIFY_BRAND_ID=               # Optional, auto-discovers first brand

# --- Airtable (Brand Brain Source) ---
AIRTABLE_TOKEN=xxx
AIRTABLE_BASE_ID=xxx

# --- Brand Brain Cache ---
BRAND_BRAIN_CACHE_TTL_SECONDS=3600
BRAND_BRAIN_REFRESH_SECRET=changeme

# --- Canva Connect API (OAuth2 PKCE) ---
CANVA_CLIENT_ID=xxx
CANVA_CLIENT_SECRET=xxx
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/canva/callback

# --- AI Image Provider (optional, fuer Hero-Images) ---
# NanoBanana
NANOBANANA_API_KEY=xxx
# OpenAI DALL-E (Fallback)
OPENAI_API_KEY=xxx
