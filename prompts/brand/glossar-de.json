{
  "_meta": {
    "version": "1.0.0",
    "language": "de",
    "description": "Verbindliches Glossar für Coop Mobile DE. Diese Begriffe müssen EXAKT so verwendet werden."
  },
  "terms": {
    "5G im Swisscom Netz": {
      "use": "IMMER bei 5G-Produkten",
      "wrong": ["5G Netz", "Swisscom 5G", "im 5G-Netz von Swisscom"],
      "context": "Pflichthinweis"
    },
    "Handy-Abo": {
      "use": "Standard-Begriff für Mobilfunk-Abonnement",
      "wrong": ["Mobile Subscription", "Mobilfunkvertrag", "Handyvertrag"],
      "context": "Allgemein"
    },
    "Coop Mobile": {
      "use": "Immer mit Grossbuchstaben, immer als zwei Wörter",
      "wrong": ["coop mobile", "CoopMobile", "COOP MOBILE", "Coop mobile"],
      "context": "Markenname"
    },
    "Lebenslanger Rabatt": {
      "use": "Bei duration=lebenslang",
      "wrong": ["Dauerhafter Rabatt", "Permanenter Rabatt", "Ewiger Rabatt"],
      "context": "Promo"
    },
    "/Mt.": {
      "use": "Suffix für monatliche Preise",
      "wrong": ["/Monat", "pro Monat", "/mo", "mtl."],
      "context": "Preis"
    },
    "CHF": {
      "use": "Vor dem Preis, mit Leerschlag: CHF 11.95",
      "wrong": ["Fr.", "SFr.", "11.95 CHF", "CHF11.95"],
      "context": "Preis"
    }
  }
}
