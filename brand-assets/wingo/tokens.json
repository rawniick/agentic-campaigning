{
  "_meta": {
    "schema_version": "1.0.0",
    "brand": "wingo",
    "brand_full_name": "Wingo (Swisscom Brand)",
    "frontify_url": "https://brand.wingo.ch/document/596",
    "tone_of_voice_url": "https://brand.wingo.ch/document/597",
    "last_updated_iso": "",
    "last_updated_by": "",
    "notes": "Aus Frontify Brand Hub manuell befuellt. Aenderungen via PR commiten - dies ist die brand source of truth fuer ALLE Renders."
  },

  "colors": {
    "primary": {
      "hex": "",
      "name": "Wingo Rot",
      "rgb": "",
      "cmyk": "",
      "usage": "Akzent-Element (Stern, CTA, Preis-Highlight). NIE als Hintergrund fuer Text."
    },
    "secondary": {
      "hex": "",
      "name": "Wingo Schwarz",
      "rgb": "",
      "cmyk": "",
      "usage": "Headlines, Fliesstext auf hellem Grund"
    },
    "background_primary": {
      "hex": "",
      "name": "Wingo Grau",
      "rgb": "",
      "usage": "Standard Hintergrund laut Brand-Mechanik 'Grauer BG + Roter Stern'"
    },
    "background_alt": {
      "hex": "#FFFFFF",
      "name": "Weiss",
      "usage": "Sekundaerer Hintergrund (Newsletter, Web-Tile)"
    },
    "neutral": {
      "scale": {
        "50": "",
        "100": "",
        "200": "",
        "300": "",
        "400": "",
        "500": "",
        "600": "",
        "700": "",
        "800": "",
        "900": ""
      },
      "usage": "Graustufen fuer Subtext, Borders, Disclaimer"
    },
    "semantic": {
      "price_old": {
        "hex": "",
        "usage": "Alter durchgestrichener Preis"
      },
      "price_new": {
        "hex": "",
        "usage": "Neuer/Aktionspreis (meist Primary)"
      },
      "success": { "hex": "", "usage": "5G Badge, Bestaetigungen" },
      "warning": { "hex": "", "usage": "Aktionsende-Countdown" }
    },
    "forbidden_combinations": [
      "z.B. 'Roter Text auf rotem Hintergrund' - aus Brand Manual eintragen"
    ]
  },

  "typography": {
    "fonts": {
      "headline": {
        "family": "",
        "fallback": "Arial Black, sans-serif",
        "file_woff2": "",
        "license_note": "Web-Lizenz pruefen, sonst Open-Source Fallback (z.B. Inter, IBM Plex Sans)"
      },
      "body": {
        "family": "",
        "fallback": "Arial, sans-serif",
        "file_woff2": ""
      },
      "monospace": {
        "family": "",
        "fallback": "Menlo, Monaco, monospace",
        "usage": "Promo-Codes, technische Identifier"
      }
    },
    "scale": {
      "display": {
        "size_px": 0,
        "line_height": 1.1,
        "letter_spacing_em": -0.02,
        "weight": 700,
        "usage": "Hero-Headlines auf Display-Standard / Welcome-Ads"
      },
      "h1": {
        "size_px": 0,
        "line_height": 1.2,
        "weight": 700,
        "usage": "Headlines auf Mid-Size Banner"
      },
      "h2": {
        "size_px": 0,
        "line_height": 1.3,
        "weight": 700
      },
      "h3": {
        "size_px": 0,
        "line_height": 1.3,
        "weight": 600
      },
      "subline": {
        "size_px": 0,
        "line_height": 1.4,
        "weight": 400,
        "usage": "Sub-Botschaft unter Headline"
      },
      "body": {
        "size_px": 0,
        "line_height": 1.5,
        "weight": 400
      },
      "caption": {
        "size_px": 0,
        "line_height": 1.4,
        "weight": 400,
        "usage": "Konditionen, kleine Hinweise"
      },
      "disclaimer": {
        "size_px": 0,
        "line_height": 1.3,
        "weight": 400,
        "min_size_px": 8,
        "usage": "Legal-Lines. Min-Size niemals unterschreiten."
      },
      "price_main": {
        "size_px": 0,
        "line_height": 1.0,
        "weight": 700,
        "usage": "Aktionspreis - prominent"
      },
      "price_suffix": {
        "size_px": 0,
        "line_height": 1.0,
        "weight": 400,
        "usage": "/Mt., /Jahr - kleiner als Hauptpreis"
      },
      "price_old": {
        "size_px": 0,
        "weight": 400,
        "text_decoration": "line-through",
        "usage": "Durchgestrichener Alt-Preis"
      },
      "cta": {
        "size_px": 0,
        "weight": 700,
        "text_transform": "none",
        "usage": "Call-to-Action Button-Label"
      }
    }
  },

  "logo": {
    "variants": {
      "stern": {
        "file": "logos/wingo-stern.svg",
        "description": "Roter Stern alleine",
        "min_size_px": 24,
        "usage": "Sehr kleine Formate, Avatar, Favicon"
      },
      "schriftlogo": {
        "file": "logos/wingo-wordmark.svg",
        "description": "Schriftzug 'wingo' ohne Stern",
        "min_size_px": 40,
        "usage": "Wenn Stern bereits separat im Layout"
      },
      "kombi": {
        "file": "logos/wingo-lockup.svg",
        "description": "Stern + Schriftzug (Standard-Lockup)",
        "min_size_px": 60,
        "usage": "Default - immer wenn Platz reicht"
      },
      "kombi_white": {
        "file": "logos/wingo-lockup-white.svg",
        "description": "Helle Variante fuer dunkle Hintergruende",
        "min_size_px": 60
      },
      "co_branding_swisscom": {
        "file": "logos/wingo-swisscom-lockup.svg",
        "description": "Co-Branding mit Swisscom (Pflicht in bestimmten Kontexten?)",
        "usage": "TODO: Wann ist Co-Branding Pflicht? Aus Brand Manual klaeren."
      }
    },
    "default_variant": "kombi",
    "clear_space": {
      "rule": "Mindestens X-Hoehe des Logos rundum frei (Schutzraum)",
      "factor_of_height": 1.0,
      "usage_note": "factor_of_height = 1.0 bedeutet Schutzraum = Logohoehe rundum"
    },
    "min_size_global_px": 24,
    "placement_defaults": [
      "oben-links bevorzugt",
      "oben-rechts erlaubt",
      "unten-rechts bei vertikalen Formaten"
    ],
    "forbidden": [
      "Logo drehen",
      "Logo verzerren / Aspect-Ratio aendern",
      "Logo-Farben aendern (Stern muss Wingo-Rot bleiben)",
      "Logo auf unruhigem Bildhintergrund ohne Kontrast-Layer"
    ]
  },

  "spacing": {
    "base_unit_px": 8,
    "snap_grid_px": 8,
    "scale": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48,
      "3xl": 64
    },
    "edge_padding_px": {
      "small_format": 16,
      "medium_format": 24,
      "large_format": 48,
      "ooh_print": 80,
      "_note": "small = <500px breit, medium = 500-1200, large = >1200, ooh_print = print"
    }
  },

  "safezones": {
    "_doc": "Safezones definieren Bereiche wo wichtiger Content liegen MUSS oder NICHT liegen darf. Per Format-Class.",
    "global_default": {
      "edge_clear_pct": 5,
      "_meta": "5% Abstand zum Rand auf allen Formaten als Minimum"
    },
    "by_format_class": {
      "display_standard": { "edge_clear_pct": 5, "important_content_zone_pct": 80 },
      "social_story_9_16": { "edge_top_pct": 15, "edge_bottom_pct": 25, "_note": "UI-Overlays oben + unten" },
      "social_square_1_1": { "edge_clear_pct": 5 },
      "google_ads_static": { "edge_clear_pct": 8, "no_text_in_creative": true },
      "ooh_print_f4_f12": { "edge_clear_pct": 7, "_note": "10mm Sicherheitsabstand bei 89.5cm" }
    },
    "logo_zone": {
      "anchor": "top-left",
      "max_size_pct_of_canvas": 15,
      "min_padding_pct": 3
    },
    "price_zone": {
      "anchor": "center",
      "prominence_rule": "Aktionspreis groesster Text auf Asset",
      "must_be_visible_pct": 100
    },
    "disclaimer_zone": {
      "anchor": "bottom",
      "min_size_pct": 1.5,
      "_note": "Mindestens 1.5% der Canvas-Hoehe fuer Disclaimer-Text"
    }
  },

  "brand_mechanik": {
    "description": "Aus Brand-Manual: 'Mechanik Grauer Hintergrund + Roter Stern in Wingo Welt'",
    "default_background_token": "background_primary",
    "default_accent_element": "stern",
    "accent_placement_options": ["top-right", "bottom-left", "behind-headline"],
    "image_treatment_rule": "Bildwelt mit Photographer-Edit (laut Brand-Manual). AI-Generation muss diesen Stil treffen oder Library-First verwenden.",
    "allowed_backgrounds": [
      "Wingo Grau",
      "Weiss",
      "Foto-Hintergrund (Bildwelt-konform)"
    ],
    "forbidden_backgrounds": [
      "Wingo Rot als Vollflaeche fuer Asset-Hintergrund",
      "Gradient-Hintergruende",
      "Konkurrenzfarben (Sunrise Lila, Salt Gruen, Yallo Gelb)"
    ]
  },

  "cta": {
    "shape": "rounded",
    "border_radius_px": 0,
    "padding_x_px": 0,
    "padding_y_px": 0,
    "background_token": "primary",
    "text_token": "background_alt",
    "hover_background": "",
    "default_labels": {
      "de": "Jetzt entdecken",
      "fr": "Decouvrir",
      "it": "Scopri ora",
      "en": "Discover now"
    },
    "_note": "Default-Labels werden im Brief von Marketer angepasst, dies sind Fallbacks"
  },

  "ai_label_default": {
    "_doc": "Globaler Fallback fuer AI-Label-Position wenn format_specs.ai_label_position null ist. Pro-Format-Konfig in DB.",
    "asset_path": "ai-label/wingo-ai-label.svg",
    "anchor": "bottom-right",
    "offset_x_pct": 2,
    "offset_y_pct": 2,
    "size_pct_of_min_dimension": 6,
    "_note": "Anchor-Optionen: top-left, top-right, bottom-left, bottom-right, center. size_pct relativ zum kleineren Canvas-Side."
  },

  "validation_rules": {
    "min_contrast_ratio_text_to_bg": 4.5,
    "min_logo_visibility_score": 0.9,
    "max_aspect_ratio_deviation": 0.01,
    "_note": "Wird in Claude-Vision-QA-Loop ueberprueft. Verletzung = Asset rot markiert."
  }
}
